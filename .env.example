# Copy to /etc/homeserver/standard-notes.env on ds1.
# The production file must be owned by deploy:deploy with mode 0600.

DB_HOST=db
DB_PORT=3306
DB_USERNAME=std_notes_user
DB_PASSWORD=GENERATE_WITH_OPENSSL_RAND_HEX_32
DB_DATABASE=standard_notes_db
DB_TYPE=mysql

MYSQL_DATABASE=standard_notes_db
MYSQL_USER=std_notes_user
MYSQL_PASSWORD=GENERATE_THE_SAME_VALUE_AS_DB_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_A_DIFFERENT_VALUE

REDIS_PORT=6379
REDIS_HOST=cache
CACHE_TYPE=redis

AUTH_JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
AUTH_SERVER_ENCRYPTION_SERVER_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
VALET_TOKEN_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

PUBLIC_FILES_SERVER_URL=https://journal-files.jdealla.com

# Leave false only until the owner creates the first account. Change to true
# immediately afterward and recreate the server container.
DISABLE_USER_REGISTRATION=false

